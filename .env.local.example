# Copiez ce fichier en .env.local (non versionne) et remplissez les valeurs.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Type d'application : "Web application"
# Authorized redirect URI (dev)  : http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod) : https://treky.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cle secrete utilisee par NextAuth pour signer les sessions JWT.
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET=

# URL publique du site (utilisee par NextAuth pour construire les redirections).
NEXTAUTH_URL=http://localhost:3000
